[Unit]
Description=LAN time server (NTP on UDP 123, serves the local clock)
After=network.target

[Service]
ExecStart=/usr/bin/env python3 /opt/lan-timeserver/ntp_server.py
Restart=always
RestartSec=5
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
